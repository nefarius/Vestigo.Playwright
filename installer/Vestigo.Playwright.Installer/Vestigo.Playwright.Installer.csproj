<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vestigo.Playwright.Installer</RootNamespace>
    <Description>Builds the Vestigo.Playwright per-machine MSI. This project is a build tool and is not installed.</Description>
    <!-- WixSharp_wix4.bin targets net461. It is a build-time MSI compiler, not a plugin dependency. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixSharp_wix4" />
    <ProjectReference Include="..\Vestigo.Playwright.Setup.Core\Vestigo.Playwright.Setup.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="License.rtf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
