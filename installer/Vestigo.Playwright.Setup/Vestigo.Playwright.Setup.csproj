<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vestigo.Playwright.Setup</RootNamespace>
    <AssemblyName>Vestigo.Playwright.Setup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Self-contained bootstrapper for the Vestigo Playwright plugin MSI. It does not download prerequisites.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vestigo.Playwright.Setup.Core\Vestigo.Playwright.Setup.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(SetupMsiPath)' != ''">
    <EmbeddedResource Include="$(SetupMsiPath)" LogicalName="Vestigo.Playwright.Setup.Payload.msi" />
  </ItemGroup>
  <Target Name="GenerateSetupPayload" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_SetupHash Condition="'$(SetupMsiHash)' == ''"></_SetupHash>
      <_SetupVersion Condition="'$(SetupProductVersion)' == ''">0.0.0</_SetupVersion>
    </PropertyGroup>
    <ItemGroup>
      <_SetupPayloadLine Include="namespace Vestigo.Playwright.Setup%3B" />
      <_SetupPayloadLine Include="internal static class SetupPayload" />
      <_SetupPayloadLine Include="{" />
      <_SetupPayloadLine Include="    internal const string ExpectedHash = &quot;$(_SetupHash)&quot;%3B" />
      <_SetupPayloadLine Include="    internal const string ProductVersion = &quot;$(_SetupVersion)&quot;%3B" />
      <_SetupPayloadLine Include="    internal const string ResourceName = &quot;Vestigo.Playwright.Setup.Payload.msi&quot;%3B" />
      <_SetupPayloadLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)SetupPayload.g.cs" Lines="@(_SetupPayloadLine)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)SetupPayload.g.cs" />
    </ItemGroup>
  </Target>
</Project>
